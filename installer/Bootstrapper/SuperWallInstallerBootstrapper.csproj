<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SuperWall-Kids-Setup-0.5.11</AssemblyName>
    <Version>0.5.11</Version>
    <AssemblyVersion>0.5.11.0</AssemblyVersion>
    <FileVersion>0.5.11.0</FileVersion>
    <InformationalVersion>0.5.11</InformationalVersion>
    <RootNamespace>SuperWallInstallerBootstrapper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\publish\installer\inner\SuperWall-Kids-Inner.exe" LogicalName="SuperWall-Kids-Inner.exe" />
  </ItemGroup>
</Project>
