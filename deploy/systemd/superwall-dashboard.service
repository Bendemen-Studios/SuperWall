[Unit]
Description=SuperWall Central Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superwall
Group=superwall
WorkingDirectory=/opt/superwall/current
EnvironmentFile=/etc/superwall/superwall.env
ExecStart=/usr/bin/dotnet /opt/superwall/current/SuperWall.Dashboard.dll
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

# Keep the dashboard service compatible with VPS/container hosts where
# systemd namespace features may be unavailable. Filesystem permissions
# remain the primary boundary.
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/superwall/current/data
ReadWritePaths=/var/lib/superwall

[Install]
WantedBy=multi-user.target
