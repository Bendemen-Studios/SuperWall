[Unit]
Description=SuperWall Central Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superwall
Group=superwall
WorkingDirectory=/opt/superwall/current
EnvironmentFile=/etc/superwall/superwall.env
ExecStart=/usr/bin/dotnet /opt/superwall/current/SuperWall.Dashboard.dll
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

# The deployment may run inside VPS/container environments where systemd
# mount/user namespaces are unavailable. Keep filesystem permissions as the
# primary boundary rather than relying on namespace-based sandboxing.
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/superwall/current/data
ReadWritePaths=/var/lib/superwall
ReadWritePaths=/var/log/superwall

[Install]
WantedBy=multi-user.target
